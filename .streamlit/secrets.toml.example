# Streamlit Secrets Configuration
# Copy this to .streamlit/secrets.toml and fill in your actual keys
# Never commit secrets.toml to git!

# --- LLM Configuration (choose one) ---
# OpenRouter (recommended)
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"
LLM_MODEL = "openai/gpt-4o-mini"

# OR OpenAI
# OPENAI_API_KEY = "sk-proj-your-openai-key"
# LLM_MODEL = "gpt-4o-mini"

# OR Anthropic
# ANTHROPIC_API_KEY = "your-anthropic-key"
# LLM_MODEL = "claude-3.5-sonnet"

LLM_TEMPERATURE = "0.2"

# --- Retrieval Tools ---
TAVILY_API_KEY = "tvly-dev-your-key"
NEWSAPI_KEY = "your-newsapi-key"

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2 = "false"
LANGCHAIN_API_KEY = "lsv2_pt_your-key"
LANGCHAIN_PROJECT = "ai-research-assistant"

# --- Research Configuration ---
MAX_RESEARCH_ITERATIONS = "2"
TARGET_SOURCE_COUNT = "20"
LOG_LEVEL = "INFO"
