# ---------------------------------------------------------------------------
# AI Research Assistant — environment variables (TEMPLATE)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM provider ---
OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Embeddings (leave provider blank to use local sentence-transformers) ---
EMBEDDINGS_PROVIDER=local        # local | openai
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# --- Web search tool ---
TAVILY_API_KEY=your-tavily-key-here

# --- News search (optional; falls back to RSS if unset) ---
NEWSAPI_KEY=

# --- Vector store ---
CHROMA_PERSIST_DIR=./.chroma

# --- Research loop control ---
MAX_RESEARCH_ITERATIONS=2
TARGET_SOURCE_COUNT=20

# --- Observability / LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai-research-assistant

# --- Logging ---
LOG_LEVEL=INFO
